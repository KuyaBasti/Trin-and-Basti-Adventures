# Copy to .env.local for local development, and set both in the Vercel
# dashboard (Project -> Settings -> Environment Variables) for production.

# The shared password for adding memories. In development this defaults to
# "letmein" if unset. In production, leaving it unset disables uploads entirely
# rather than leaving them open to anyone with the link.
ALBUM_PASSWORD=

# Created for you when you add a Blob store in the Vercel dashboard
# (Storage -> Create -> Blob). Leave this blank locally: with no token the app
# stores uploads in .data/ and public/uploads/ on your own machine instead.
BLOB_READ_WRITE_TOKEN=
